{
  "expo": {
    "name": "RookHub Motorista",
    "slug": "rookhub-driver",
    "scheme": "rookhub",
    "version": "0.1.0",
    "platforms": ["ios", "android", "web"],
    "orientation": "portrait",
    "icon": "./assets/logo-rookhub-white-html.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0A0A0A",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo-rookhub-white.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rookhub.driver"
    },
    "android": {
      "package": "com.rookhub.driver",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/logo-rookhub-white-html-foreground.png",
        "monochromeImage": "./assets/logo-rookhub-white-html-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "O RookHub usa a câmera para anexar a foto do item reprovado no checklist e do comprovante de abastecimento.",
          "microphonePermission": false
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
