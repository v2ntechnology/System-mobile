{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    /* O Next resolve `paths` sozinho, no webpack e no Turbopack — não há alias
       duplicado em next.config.ts. Sem `baseUrl`: o TypeScript já o marca como
       deprecado e os padrões relativos abaixo bastam. */
    "paths": {
      "@/*": ["./src/*"],
      "@imgs/*": ["../../imgs/*"]
    },
    "esModuleInterop": true,
    "jsx": "preserve"
  },
  "include": [
    "next-env.d.ts",
    "src",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
