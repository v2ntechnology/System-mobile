{
  "expo": {
    "name": "RookHub Motorista",
    "slug": "rookhub-driver",
    "scheme": "rookhub",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#212121",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#212121"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rookhub.driver"
    },
    "android": {
      "package": "com.rookhub.driver",
      "adaptiveIcon": {
        "backgroundColor": "#212121",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "O RookHub usa a câmera para anexar a foto do item reprovado no checklist e do comprovante de abastecimento."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
